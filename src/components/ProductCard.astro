---
import type { Product } from '../data/products';
const { product } = Astro.props as { product: Product };
const base = import.meta.env.BASE_URL;
const brandImage = product.brandImage ? `${base}${product.brandImage}` : null;
---
<article class={`product-card ${product.accent}`} data-tilt-card>
  <div class="product-art" data-spotlight><span class="art-grid"></span><span class="art-orbit"></span><span class="art-orbit art-orbit-two"></span><span class:list={['art-core', { 'has-brand-image': brandImage }]}>{brandImage ? <img class="product-brand-image" src={brandImage} width="1024" height="1024" loading="lazy" decoding="async" alt="" /> : product.logo}</span><span class="art-pulse"></span><span class="art-label"><i></i>{product.status}</span><span class="art-signal">{product.name === 'Foresight' ? 'LIFE / MEMORY / INTENT' : product.name === 'AURA News' ? 'READ / CONTEXT / SIGNAL' : 'CARE / CONTEXT / CLARITY'}</span></div>
  <div class="product-card-body"><p class="eyebrow">{product.name}</p><h3>{product.tagline}</h3><p>{product.description}</p><a class="text-link" href={`${base}products/${product.slug}/`}>Learn more <span aria-hidden="true">↗</span></a></div>
</article>
