---
import type { Product } from '../data/products';
const { product } = Astro.props as { product: Product };
const base = import.meta.env.BASE_URL;
---
<article class={`product-card ${product.accent}`}>
  <div class="product-art"><span class="art-orbit"></span><span class="art-core">{product.logo}</span><span class="art-label">{product.status}</span></div>
  <div class="product-card-body"><p class="eyebrow">{product.name}</p><h3>{product.tagline}</h3><p>{product.description}</p><a class="text-link" href={`${base}products/${product.slug}/`}>Learn more <span aria-hidden="true">↗</span></a></div>
</article>
