---
import type { Product } from '../data/products';
const { product } = Astro.props as { product: Product };
const base = import.meta.env.BASE_URL;
const brandImage = product.brandImage ? `${base}${product.brandImage}` : null;
---
<section class={`product-hero ${product.accent}`}><div class="container product-hero-grid"><div class="reveal"><a class="back-link" href={`${base}products/`}>← All products</a><p class="eyebrow">A Foresight Labs product · {product.status}</p><h1>{product.name}<span class="period">.</span></h1><p class="lede">{product.tagline}</p><p class="hero-copy">{product.description}</p><div class="action-row"><span class="button button-muted">In development</span><a class="text-link" href={`${base}contact/`}>Get updates <span>↗</span></a></div></div><div class="product-device reveal" aria-label={`${product.name} identity`}><div class="device-top"><span>{product.logo}</span><span>{product.name}</span><span>•••</span></div><div class:list={['device-signal', { 'has-brand-image': brandImage }]}>{brandImage && <img class="product-brand-image" src={brandImage} width="1024" height="1024" decoding="async" fetchpriority="high" alt="" />}</div><div class="device-lines"><span></span><span></span><span></span></div><div class="device-note">{product.deviceLabel}<small>Made for a little more clarity.</small></div></div></div></section>
<section class="section"><div class="container split-section"><div><p class="eyebrow">The intention</p><h2>{product.purpose}</h2></div><div><p>{product.philosophy}</p><p class="trust-note">{product.trust}</p></div></div></section>
<section class="section section-tint"><div class="container"><div class="section-heading"><div><p class="eyebrow">{product.capabilityEyebrow}</p><h2>{product.capabilityHeading}</h2></div><p>{product.capabilitySummary}</p></div><div class="capability-grid">{product.capabilities.map((capability, index) => <div class="capability reveal"><span>0{index + 1}</span><h3>{capability}</h3><p>{product.capabilityDescriptions[index]}</p></div>)}</div></div></section>
<section class="cta-band"><div class="container cta-content"><p class="eyebrow">Keep in touch</p><h2>Good things take<br /><em>thought.</em></h2><a class="button button-dark" href={`${base}contact/`}>Talk to Foresight Labs ↗</a></div></section>
