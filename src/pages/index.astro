---
import Layout from '../layouts/Layout.astro'; import ProductCard from '../components/ProductCard.astro'; import ProductEcosystem from '../components/ProductEcosystem.astro'; import { products } from '../data/products';
const base = import.meta.env.BASE_URL;
---
<Layout title="Foresight Labs · Thoughtful software for everyday intelligence." description="Foresight Labs creates refined digital products that turn complex information into calm, useful and human-centred experiences.">
  <section class="home-hero"><div class="hero-atmosphere"></div><div class="container hero-container"><div class="hero-copy-block"><p class="eyebrow reveal">Independent intelligence studio <span class="eyebrow-dot"></span> 2026</p><h1 class="reveal">Thoughtful software<br />for everyday <em>intelligence.</em></h1><div class="hero-intro reveal"><p>Foresight Labs creates refined digital products that turn complex information into calm, useful and human-centred experiences.</p><div class="hero-actions"><a class="button button-dark" href={`${base}products/`}>Explore our products <span>↗</span></a><a class="text-link" href={`${base}about/`}>About the studio</a></div></div></div><div class="hero-meta reveal"><div><span>Studio signal</span><strong>Privacy-conscious systems</strong></div><div><span>In development</span><strong>Foresight · AURA · NovaRX</strong></div></div></div></section>
  <section class="section signal-section"><div class="container studio-lede reveal"><p class="eyebrow">A quieter kind of progress</p><h2>Technology should leave more room for being human.</h2><p>We make products for the moments when information becomes overwhelming, routines become complicated, or the important thing is simply hard to see. Our work pairs practical technology with considered interfaces and responsible intelligence.</p></div></section>
  <ProductEcosystem />
  <section class="section section-tint"><div class="container"><div class="section-heading"><div><p class="eyebrow">Selected work</p><h2>Made with intention.</h2></div><p>Three products, each exploring a different way thoughtful software can support everyday life.</p></div><div class="product-grid">{products.map((product) => <ProductCard product={product} />)}</div></div></section>
  <section class="section principles-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">Our principles</p><h2>Small signals.<br /><em>Better systems.</em></h2></div><p>Good design is a way of paying attention. These are the ideas we return to when the answer is not obvious.</p></div><div class="principles"><div class="principle reveal"><span>01</span><h3>Make it calm</h3><p>Interfaces should reduce cognitive load, not add to it.</p></div><div class="principle reveal"><span>02</span><h3>Earn trust</h3><p>Be honest about what a system knows, does and does not do.</p></div><div class="principle reveal"><span>03</span><h3>Keep learning</h3><p>Build with curiosity, then leave enough room to change.</p></div></div></div></section>
  <section class="cta-band"><div class="cta-signal" aria-hidden="true"></div><div class="container cta-content"><div><p class="eyebrow">Enter the laboratory</p><h2>Have an idea worth<br /><em>exploring?</em></h2></div><a class="button button-dark" href={`${base}contact/`}>Start a conversation <span>↗</span></a></div></section>
</Layout>
